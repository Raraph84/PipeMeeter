{
  "name": "pipemeeter",
  "version": "1.0.0",
  "description": "",
  "main": "dist/main.js",
  "scripts": {
    "dev:app": "tsc && NODE_ENV=development electron .",
    "dev:renderer": "npm run dev --prefix renderer",
    "dev": "concurrently \"npm run dev:renderer\" \"npm run dev:app\"",
    "build:app": "tsc",
    "build:renderer": "npm run build --prefix renderer",
    "build": "npm run build:renderer && npm run build:app",
    "start": "npm run build && electron-forge start",
    "package": "npm run build && electron-forge package"
  },
  "keywords": [],
  "author": "Raraph84",
  "license": "ISC",
  "type": "module",
  "dependencies": {
    "pipewire": "^2.8.0"
  },
  "devDependencies": {
    "@electron-forge/cli": "^7.11.2",
    "@types/node": "^26.6.3",
    "concurrently": "^10.0.5",
    "electron": "^44.4.5",
    "prettier": "^3.9.9",
    "typescript": "^7.0.2"
  },
  "prettier": {
    "tabWidth": 4,
    "trailingComma": "none",
    "printWidth": 120,
    "overrides": [
      {
        "files": [
          "package.json",
          "package-lock.json",
          "tsconfig.json"
        ],
        "options": {
          "tabWidth": 2
        }
      }
    ]
  }
}
